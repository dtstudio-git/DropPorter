#include <winver.h>

1 ICON "../ui/DropPorter.Wpf/DropPorter.ico"

#if defined(DROPPORTER_RUNTIME)
#define DROPPORTER_DESCRIPTION "Drop Porter Runtime"
#define DROPPORTER_FILENAME "DropPorterRuntime.exe"
#elif defined(DROPPORTER_RECEIVE_WORKER)
#define DROPPORTER_DESCRIPTION "Drop Porter File Receiver"
#define DROPPORTER_FILENAME "DropPorterFileReceiver.exe"
#else
#define DROPPORTER_DESCRIPTION "Drop Porter Wi-Fi"
#define DROPPORTER_FILENAME "DropPorterWireless.exe"
#endif

1 VERSIONINFO
    FILEVERSION 0,1,0,0
    PRODUCTVERSION 0,1,0,0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", DROPPORTER_DESCRIPTION
            VALUE "FileVersion", "0.1.0"
            VALUE "OriginalFilename", DROPPORTER_FILENAME
            VALUE "ProductName", "Drop Porter"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
