<Window x:Class="DropPorter.Wpf.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="設定" Icon="DropPorter.ico" Width="{StaticResource SettingsWindowWidth}" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="{StaticResource PagePadding}">
    <CheckBox x:Name="KeepRadio" Content="送受信のたびにWi-Fiを元に戻さない" Click="KeepRadioClicked" />
    <TextBlock Style="{StaticResource FieldSecondary}" Margin="{StaticResource SettingDescriptionGap}"
               Text="オンにすると、送受信後の待ち時間が短くなります。&#10;アプリを開いている間は、送受信に使うWi-Fi子機で普段のWi-Fiに接続できません。アプリを閉じるか、オフにすると、子機は元の接続状態に戻ります。" />
    <TextBlock x:Name="SaveError" Style="{StaticResource BodyText}" Text="設定を保存できませんでした。もう一度お試しください。" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
    <Button Content="閉じる" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Click="CloseClicked" />
  </StackPanel>
</Window>
